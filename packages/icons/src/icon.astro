---
import type { IconName } from './names';

// Stroke icons drawn on one 24px grid at one weight.
type Props = { name: IconName; class?: string; filled?: boolean };
const { name, class: className, filled = false } = Astro.props;
---

<svg
  class={className}
  viewBox={name.startsWith('chevron-') ? '0 0 16 16' : '0 0 24 24'}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'agent' && (
      <Fragment>
        <path d="M12 21c-3-3.6-6-7.2-6-11a6 6 0 1 1 12 0c0 3.8-3 7.4-6 11Z" />
        <path d="M10 9.5h.01M14 9.5h.01" stroke-width="2.4" />
      </Fragment>
    )
  }
  {
    name === 'idea' && (
      <Fragment>
        <circle cx="6" cy="5" r="2" />
        <circle cx="18" cy="7" r="2" />
        <path d="M6 7v8a3 3 0 0 0 3 3h6M18 9v5" />
        <path d="m13 15 3 3-3 3" />
      </Fragment>
    )
  }
  {
    name === 'issue' && (
      <Fragment>
        <circle cx="12" cy="12" r="8.5" />
        <circle cx="12" cy="12" r="2" />
      </Fragment>
    )
  }
  {name === 'chat' && <path d="M20 12a7.5 7.5 0 0 1-11 6.6L4 20l1.4-4.6A7.5 7.5 0 1 1 20 12Z" />}
  {
    name === 'calendar' && (
      <Fragment>
        <rect x="3.5" y="5" width="17" height="15" rx="2.5" />
        <path d="M3.5 10h17M8 3v4M16 3v4" />
      </Fragment>
    )
  }
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" stroke-width="2.2" />}
  {name === 'chevron-up' && <path d="m4 10 4-4 4 4" />}
  {name === 'chevron-down' && <path d="m4 6 4 4 4-4" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {
    name === 'users' && (
      <Fragment>
        <circle cx="9" cy="8" r="3.5" />
        <path d="M2.5 20a6.5 6.5 0 0 1 13 0" />
        <path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18.5 14a6.5 6.5 0 0 1 3 6" />
      </Fragment>
    )
  }
  {name === 'pause' && <path d="M9 6v12M15 6v12" stroke-width="2" />}
  {name === 'play' && <path d="M8 5.5v13l10-6.5-10-6.5Z" />}
</svg>
