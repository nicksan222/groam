{
  "name": "Groam Convex",
  // Tool pins (Claude Code, Vite+, Graphify, Headroom) live only in the Dockerfile ARGs.
  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "1.3.11"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "runArgs": ["--init"],
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/node/.claude.json,type=bind",
    "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind"
  ],
  "containerEnv": {
    "DISABLE_AUTOUPDATER": "1",
    "HEADROOM_BEACON": "off"
  },

  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "ANTHROPIC_BASE_URL": "${localEnv:ANTHROPIC_BASE_URL}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "OPENAI_BASE_URL": "${localEnv:OPENAI_BASE_URL}",
    "GOOGLE_GENERATIVE_AI_API_KEY": "${localEnv:GOOGLE_GENERATIVE_AI_API_KEY}",
    "GOOGLE_GENERATIVE_AI_BASE_URL": "${localEnv:GOOGLE_GENERATIVE_AI_BASE_URL}"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "forwardPorts": [3210, 3211, 5173, 6790],
  "portsAttributes": {
    "3210": {
      "label": "Convex API",
      "onAutoForward": "silent"
    },
    "3211": {
      "label": "Convex HTTP and hosting",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "Web app (Vite)",
      "onAutoForward": "openPreview"
    },
    "6790": {
      "label": "Convex dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "VoidZero.vite-plus-extension-pack",
        "anthropic.claude-code",
        "oven.bun-vscode"
      ],
      "settings": {
        // The extension spawns its bundled binary directly, bypassing the shell
        // alias; route it through the repository harness instead. The wrapper is
        // invoked as `<wrapper> <bundled-claude-path> <args...>`.
        "claudeCode.claudeProcessWrapper": "${containerWorkspaceFolder}/tooling/claude/claude.sh",
        "typescript.tsdk": "node_modules/typescript/lib",
        "typescript.enablePromptUseWorkspaceTsdk": true,
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "oxc.disableNestedConfig": true,
        "oxc.fmt.disableNestedConfig": true,
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.codeActionsOnSave": {
          "source.fixAll.oxc": "explicit"
        },
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/dist/**": true
        }
      }
    }
  }
}
