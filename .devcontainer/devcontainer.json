{
  "name": "Groam Convex",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "GRAPHIFY_EXCLUDE_NEWER": "2026-09-18",
      "GRAPHIFY_VERSION": "0.9.63",
      "CLAUDE_VERSION": "2.1.287",
      "HERDR_VERSION": "0.9.3"
    }
  },

  "features": {
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "1.3.11"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/rust:1": {
      "profile": "minimal",
      "version": "stable"
    }
  },

  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "runArgs": ["--init"],
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/node/.claude.json,type=bind",
    "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind"
  ],
  "containerEnv": {
    "DISABLE_AUTOUPDATER": "1"
  },

  "remoteEnv": {
    "TURBO_CACHE_DIR": "${containerWorkspaceFolder}/.turbo/cache",
    "TURBO_ROOT_TURBO_JSON": "${containerWorkspaceFolder}/turbo.json",
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "ANTHROPIC_BASE_URL": "${localEnv:ANTHROPIC_BASE_URL}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "OPENAI_BASE_URL": "${localEnv:OPENAI_BASE_URL}",
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
    "GOOGLE_API_KEY": "${localEnv:GOOGLE_API_KEY}",
    "DEEPSEEK_API_KEY": "${localEnv:DEEPSEEK_API_KEY}",
    "KIMI_API_KEY": "${localEnv:KIMI_API_KEY}",
    "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "forwardPorts": [3210, 3211, 4321, 5173, 6790],
  "portsAttributes": {
    "3210": {
      "label": "Convex API",
      "onAutoForward": "silent"
    },
    "3211": {
      "label": "Convex HTTP and hosting",
      "onAutoForward": "silent"
    },
    "4321": {
      "label": "Landing (Astro)",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "Web app (Vite)",
      "onAutoForward": "openPreview"
    },
    "6790": {
      "label": "Convex dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "biomejs.biome",
        "anthropic.claude-code",
        "oven.bun-vscode"
      ],
      "settings": {
        "typescript.tsdk": "node_modules/typescript/lib",
        "typescript.enablePromptUseWorkspaceTsdk": true,
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.biome": "explicit"
        },
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/dist/**": true
        }
      }
    }
  }
}
