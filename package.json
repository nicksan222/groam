{
  "name": "groam-workspace",
  "version": "0.0.0",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5",
    "vite-plus": "1.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-istanbul": "5.0.5"
  },
  "dependencies": {
    "@groam/env": "workspace:*",
    "convex": "^1.46.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "fallow": "3.30.0",
    "jiti": "^2.7.0",
    "react-doctor": "0.9.14",
    "syncpack": "^15.3.3",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "license": "MIT",
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "brace-expansion": "^5.0.12",
    "fast-uri": "^3.1.8",
    "hono": "^4.13.5",
    "nanoid": "^3.3.17",
    "source-map-js": "^1.2.2",
    "undici": "^7.29.1",
    "zod": "^4.6.5",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@vitest/browser": "5.0.5",
    "@vitest/ui": "5.0.5"
  },
  "packageManager": "bun@1.3.11",
  "patchedDependencies": {
    "playwright-core@1.63.0": "patches/playwright-core@1.63.0.patch"
  },
  "private": true,
  "scripts": {
    "audit": "vp pm audit",
    "auth:schema": "vp run --fail-if-no-match --filter @groam/backend auth:schema",
    "brand:generate": "vp run --fail-if-no-match --filter @groam/brand generate",
    "build": "vp run --fail-if-no-match --filter \"@groam/*\" build",
    "build:landing": "vp run --fail-if-no-match --filter @groam/landing build",
    "build:web": "vp run --fail-if-no-match --filter @groam/web build",
    "check": "vp run audit && vp run typecheck && vp run lint && vp run test && vp run react-doctor && vp run fallow",
    "codegen": "vp run codegen:auth && vp run codegen:convex",
    "codegen:auth": "vp run auth:schema",
    "codegen:convex": "vp exec convex codegen",
    "convex:dashboard": "vp exec convex dashboard",
    "convex:deploy": "vp exec convex deploy --typecheck-components",
    "convex:dev": "vp exec convex dev --typecheck-components",
    "deploy": "vp run deploy:production",
    "deploy:beta": "vp run --fail-if-no-match --filter @groam/deploy deploy:beta",
    "deploy:preflight": "vp run --fail-if-no-match --filter @groam/deploy preflight",
    "deploy:production": "vp run --fail-if-no-match --filter @groam/deploy deploy:production",
    "deploy:setup": "vp run --fail-if-no-match --filter @groam/deploy setup",
    "dev": "vp run --fail-if-no-match --filter \"@groam/*\" --parallel --log labeled dev",
    "dev:web": "vp run --fail-if-no-match --filter @groam/web dev",
    "diagrams:render": "vp run --fail-if-no-match --filter @groam/diagrams render",
    "fallow": "vp exec fallow -c tooling/fallow.config.jsonc --fail-on-issues && vp exec fallow -c tooling/fallow.config.jsonc health --css",
    "fallow:changed": "vp exec fallow audit -c tooling/fallow.config.jsonc --changed-since HEAD --gate all && vp exec fallow security -c tooling/fallow.config.jsonc --changed-since HEAD --gate new",
    "fallow:strict": "vp exec fallow -c tooling/fallow.config.jsonc --fail-on-issues --type-aware-require complete && vp exec fallow -c tooling/fallow.config.jsonc health --css --type-aware-require complete",
    "format": "vp exec syncpack format --config tooling/syncpack.config.json && vp check --fix",
    "format:check": "vp exec syncpack format --check --config tooling/syncpack.config.json && vp fmt --check",
    "lint": "vp run lint:conventions && vp run lint:agents && vp run lint:packages && vp check",
    "lint:agents": "bun tooling/quality/check-agent-tooling.ts",
    "lint:claude": "vp run lint:agents",
    "lint:conventions": "bun tooling/quality/check-conventions.ts",
    "lint:packages": "vp exec syncpack lint --config tooling/syncpack.config.json && vp exec syncpack format --check --config tooling/syncpack.config.json",
    "preconvex:dev": "bun tooling/devkit/prepare-convex.ts",
    "predev": "bun tooling/devkit/prepare-convex.ts",
    "prepare": "vp config --hooks-dir tooling/hooks --no-agent",
    "preview": "vp run --fail-if-no-match --filter \"@groam/*\" --parallel preview",
    "react-doctor": "vp exec react-doctor -y --blocking warning --no-dead-code --no-score .",
    "react-doctor:changed": "vp exec react-doctor -y --blocking warning --scope changed --base origin/main --no-dead-code --no-score .",
    "react-doctor:staged": "vp exec react-doctor --blocking warning --staged --no-dead-code --no-score .",
    "seed": "bun --env-file .env.local tooling/seeder/src/cli.ts",
    "test": "vp run test:quality && vp run --fail-if-no-match --filter \"@groam/*\" --cache --concurrency-limit 2 test",
    "test:browsers:install": "vp run --fail-if-no-match --filter @groam/vitest-config browsers:install",
    "test:deployed": "vp run --fail-if-no-match --filter @groam/deploy test:deployed",
    "test:journeys": "vp run --fail-if-no-match --filter @groam/web journeys",
    "test:landing": "vp run --fail-if-no-match --filter @groam/landing test",
    "test:packages": "vp run test:quality && vp run --fail-if-no-match --filter \"@groam/*\" --filter \"!@groam/web\" --filter \"!@groam/landing\" --filter \"!@groam/ui\" --filter \"!@groam/ai\" --filter \"!@groam/auth\" --cache --concurrency-limit 2 test",
    "test:quality": "vp test run --dir tooling/quality",
    "test:ui": "vp run --fail-if-no-match --filter @groam/ui --filter @groam/ai --filter @groam/auth --cache --concurrency-limit 2 test",
    "test:web": "vp run --fail-if-no-match --filter @groam/web --cache test",
    "typecheck": "vp run --fail-if-no-match --filter \"@groam/*\" --cache typecheck && tsc --noEmit -p tooling/tsconfig.json"
  },
  "trustedDependencies": [
    "fallow"
  ],
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/app-actions",
    "tooling/devkit",
    "tooling/diagrams",
    "tooling/seeder",
    "tooling/typescript-config",
    "tooling/vitest-config",
    "tooling/deploy"
  ]
}
