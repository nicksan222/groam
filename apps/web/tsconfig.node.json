{
  "extends": "@groam/typescript-config/node.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": { "#ai/*": ["../../packages/ai/src/*"] },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "void.config.ts", "src/journeys/void-pages-manifest.ts"]
}
