  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "e2e": "env -u NO_COLOR -u FORCE_COLOR playwright test",
    "e2e:headed": "env -u NO_COLOR -u FORCE_COLOR playwright test --headed",
    "e2e:install": "playwright install chromium",
    "e2e:local": "PLAYWRIGHT_BASE_URL=http://localhost:5173 env -u NO_COLOR -u FORCE_COLOR playwright test",
    "e2e:local:headed": "PLAYWRIGHT_BASE_URL=http://localhost:5173 env -u NO_COLOR -u FORCE_COLOR playwright test --headed",
    "lint": "biome check .",
    "preview": "vite preview --host 0.0.0.0",
    "routes:generate": "NODE_ENV=production tsr generate",
    "test": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "type": "module"
}
