---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  tone?: 'paper' | 'bill' | 'press';
  layout?: 'stack' | 'split';
}

const { tone = 'paper', layout = 'stack', class: className, ...attributes } = Astro.props;
---

<section
  {...attributes}
  class:list={['page-section', className, { bill: tone === 'bill', 'bill-ink': tone === 'press' }]}
  data-page-section
  data-section-tone={tone}
>
  <div class:list={['wrap', 'section-content', `layout-${layout}`]} data-section-content>
    <slot />
  </div>
  <slot name="bleed" />
</section>

<style>
  .page-section {
    min-width: 0;
    padding-block: calc(var(--section) / 2);
  }
  .page-section[data-section-tone='bill'],
  .page-section[data-section-tone='press'] {
    padding-block: var(--section);
  }
  .section-content {
    display: grid;
    gap: var(--content-gap);
    min-width: 0;
  }
  @media (min-width: 900px) {
    .layout-split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--column-gap);
      align-items: start;
    }
  }
</style>
