---
import { env } from '@groam/env/landing';
import { teaser } from '@/content/pricing';
---

<section class="wrap teaser" aria-labelledby="pricing-teaser-title" data-pricing-teaser>
  <div class="copy">
    <h2 class="section-title" id="pricing-teaser-title">{teaser.heading}</h2>
    <p class="example">{teaser.example}</p>
    <div class="actions">
      <a class="btn btn-primary btn-lg" href={env.appUrl}>Start a trip</a>
      <a class="btn btn-outline btn-lg" href="/pricing/">See pricing</a>
    </div>
  </div>

  <div class="prices" role="group" aria-label="Prices">
    <div class="price">
      <span class="amount">{teaser.free.price}</span>
      <span class="label">{teaser.free.label}</span>
      <span class="avatar-row" aria-hidden="true">
        <span class="avatar avatar-maya big">M</span>
      </span>
    </div>
    <div class="plus" aria-hidden="true">+</div>
    <div class="price">
      <span class="amount">{teaser.paid.price}</span>
      <span class="label">{teaser.paid.label}</span>
      <span class="avatar-row" aria-hidden="true">
        <span class="stamped">
          <span class="avatar avatar-jonas big">J</span>
          <span class="tag">€1</span>
        </span>
        <span class="stamped second">
          <span class="avatar avatar-priya big">P</span>
          <span class="tag">€1</span>
        </span>
        <span class="stamped third">
          <span class="avatar avatar-sam big">S</span>
          <span class="tag">€1</span>
        </span>
      </span>
    </div>
  </div>
</section>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-pricing-teaser]')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    el.classList.add('armed');
    const io = new IntersectionObserver(([entry]) => {
      if (!entry?.isIntersecting) return;
      el.classList.add('in');
      io.disconnect();
    }, { threshold: 0.4 });
    io.observe(el);
  }
</script>

<style>
  .teaser {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    padding-block: clamp(48px, 7vw, 96px);
  }
  .copy {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .example {
    max-width: 46ch;
    color: var(--muted-foreground);
    font-size: 1.05rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }
  .prices {
    display: flex;
    align-items: stretch;
    gap: 12px;
  }
  .price {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .amount {
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .label {
    color: var(--muted-foreground);
    font-size: 14px;
  }
  .plus {
    align-self: center;
    color: var(--muted-foreground);
    font-size: 1.4rem;
  }
  .avatar-row {
    display: flex;
    gap: 22px;
    margin-top: 16px;
    min-height: 44px;
  }
  .big {
    width: 36px;
    height: 36px;
    font-size: 14px;
  }
  .stamped {
    position: relative;
    display: inline-flex;
  }
  .tag {
    position: absolute;
    top: -9px;
    right: -16px;
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--primary);
    color: var(--primary-foreground);
    font: 600 11px/1.5 var(--font-mono);
    transform: rotate(6deg);
    box-shadow: var(--shadow-xs);
  }
  .armed:not(.in) .tag {
    opacity: 0;
    transform: translateY(-14px) scale(1.7) rotate(-8deg);
  }
  .armed.in .tag {
    animation: stamp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.3s backwards;
  }
  .armed.in .second .tag {
    animation-delay: 0.65s;
  }
  .armed.in .third .tag {
    animation-delay: 1s;
  }
  @keyframes stamp {
    from {
      opacity: 0;
      transform: translateY(-14px) scale(1.7) rotate(-8deg);
    }
    to {
      opacity: 1;
      transform: rotate(6deg);
    }
  }
  @media (max-width: 860px) {
    .teaser {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .prices {
      flex-direction: column;
    }
    .plus {
      display: none;
    }
  }
</style>
