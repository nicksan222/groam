---
import { laneTrips } from '@/content/pricing';

const copies = [0, 1];
---

<section class="lane" aria-labelledby="lane-title" data-pricing-lane>
  <div class="wrap head">
    <div>
      <h2 class="section-title" id="lane-title">Pay once per traveler</h2>
      <p class="section-lede">The same friends, trip after trip. Only a traveler's first trip carries the €1.</p>
    </div>
    <div class="tools">
      <span class="example-label">Example trips</span>
      <button class="toggle" type="button" data-toggle aria-pressed="false" hidden>
        <span class="icon when-playing" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M9 6v12M15 6v12" stroke-width="2" /></svg>
        </span>
        <span class="icon when-paused" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l10-6.5-10-6.5Z" /></svg>
        </span>
        <span class="sr">Pause trip lane</span>
      </button>
    </div>
  </div>

  <div class="viewport" role="group" aria-label="Example trips where each traveler is charged only on their first trip">
    <div class="track" data-track>
      {
        copies.map((copy) => (
          <ul class="set" aria-hidden={copy === 1 ? 'true' : undefined}>
            {laneTrips.map((trip) => (
              <li class="surface trip">
                <h3>{trip.name}<span class="when">{trip.when}</span></h3>
                <ul class="roster">
                  {trip.roster.map((who, i) => (
                    <li class={`who ${who.state}`} style={`--i:${i}`}>
                      <span class="hop">
                        <span class={`avatar big avatar-${who.id}`}>{who.initial}</span>
                      </span>
                      <span class="chip-state">
                        {who.state === 'paid' ? '€1' : who.state === 'covered' ? 'covered' : 'organizer'}
                      </span>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
            <li class="trip endcap">
              <p>and every trip after that: €0 for anyone covered</p>
            </li>
          </ul>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { playPricingLane } from '@/scripts/pricing-lane';

  for (const lane of document.querySelectorAll<HTMLElement>('[data-pricing-lane]')) playPricingLane(lane);
</script>

<style>
  .lane {
    display: grid;
    gap: 28px;
    padding-block: clamp(32px, 5vw, 72px);
  }
  .viewport {
    padding-inline: var(--gutter);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .toggle {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--background);
    color: var(--muted-foreground);
    cursor: pointer;
  }
  .toggle:hover {
    color: var(--foreground);
    background: var(--muted);
  }
  .toggle:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .toggle[hidden] {
    display: none;
  }
  .icon svg {
    width: 16px;
    height: 16px;
    display: block;
  }
  .when-paused,
  .toggle[aria-pressed='true'] .when-playing {
    display: none;
  }
  .toggle[aria-pressed='true'] .when-paused {
    display: block;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .viewport {
    overflow: hidden;
  }
  .track {
    display: flex;
    width: max-content;
    animation: lane 70s linear infinite;
  }
  .viewport[data-state='paused'] :global(*),
  .viewport[data-state='offscreen'] :global(*),
  .viewport[data-state='paused'] .track,
  .viewport[data-state='offscreen'] .track {
    animation-play-state: paused;
  }
  .set {
    display: flex;
    gap: 20px;
    padding-right: 20px;
    list-style: none;
  }
  .trip {
    flex: none;
    width: 348px;
    min-height: 150px;
    padding: 18px 20px 20px;
    display: grid;
    gap: 22px;
    align-content: start;
  }
  .endcap {
    border: 1px dashed var(--input);
    border-radius: var(--radius-card);
    align-content: center;
    color: var(--muted-foreground);
  }
  .trip h3 {
    font-size: 1rem;
    font-weight: 600;
  }
  .roster {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 2px;
  }
  .who {
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 48px;
  }
  .big {
    width: 28px;
    height: 28px;
    font-size: 12px;
  }
  .hop {
    display: inline-flex;
    animation: hop 3.6s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    animation-delay: calc(var(--i) * 0.35s);
  }
  .chip-state {
    font-size: 11.5px;
    line-height: 1.3;
    color: var(--muted-foreground);
  }
  .who.paid .chip-state {
    padding: 0 6px;
    border-radius: 6px;
    background: var(--primary);
    color: var(--primary-foreground);
    font: 600 11px/1.6 var(--font-mono);
  }
  .who.covered .chip-state {
    color: var(--foreground);
    font-weight: 600;
  }
  .avatar-lena {
    background: var(--avatar-teal);
    color: var(--avatar-teal-foreground);
  }
  .when {
    display: block;
    margin-top: 2px;
    font-size: 12.5px;
    font-weight: 400;
    color: var(--muted-foreground);
  }
  .avatar-ravi {
    background: var(--avatar-yellow);
    color: var(--avatar-yellow-foreground);
  }
  .avatar-ana {
    background: var(--avatar-lavender);
    color: var(--avatar-lavender-foreground);
  }
  .avatar-noor {
    background: var(--avatar-sky);
    color: var(--avatar-sky-foreground);
  }
  @keyframes lane {
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes hop {
    0%,
    70%,
    100% {
      transform: translateY(0);
    }
    82% {
      transform: translateY(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .viewport {
      overflow-x: auto;
    }
    .track {
      animation: none;
      width: auto;
    }
    .set[aria-hidden='true'] {
      display: none;
    }
    .hop {
      animation: none;
    }
  }
</style>
