---
import { faq } from '@/content/pricing';
import PageSection from '@/components/page-section.astro';
---

<PageSection layout="split" class="faq" aria-labelledby="faq-title">
    <h2 class="section-title" id="faq-title">{faq.heading}</h2>
    <div class="list">
      {
        faq.items.map((item) => (
          <details>
            <summary>
              <span class="q">{item.q}</span>
              <span class="mark" aria-hidden="true" />
            </summary>
            <div class="answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
</PageSection>

<style>
  p {
    text-wrap: pretty;
  }
  .section-title {
    text-wrap: balance;
  }
  .list {
    border-top: var(--rule) solid var(--ink);
    border-bottom: var(--rule) solid var(--ink);
  }
  details + details {
    border-top: 1.5px solid var(--ink-line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    padding-block: 18px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .q {
    text-wrap: balance;
    font-weight: 800;
    font-stretch: 78%;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.1;
    text-transform: uppercase;
    word-spacing: var(--caps-space);
  }
  .mark {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border: 2px solid var(--ink);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .mark::before,
  .mark::after {
    content: '';
    position: absolute;
    inset: 50% 6px auto;
    height: 2px;
    margin-top: -1px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }
  .mark::after {
    transform: rotate(90deg);
  }
  summary:hover .mark {
    background: var(--ink);
    color: var(--paper);
  }
  details[open] .mark::after {
    transform: rotate(0deg);
  }
  summary:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .answer p {
    padding-bottom: 22px;
    max-width: 56ch;
    color: var(--ink-soft);
    line-height: 1.55;
  }
  @supports (interpolate-size: allow-keywords) {
    details {
      interpolate-size: allow-keywords;
    }
    details::details-content {
      block-size: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        block-size 0.5s var(--ease),
        opacity 0.4s var(--ease),
        content-visibility 0.5s allow-discrete;
    }
    details[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }
  @supports not (interpolate-size: allow-keywords) {
    details[open] .answer {
      animation: reveal 0.45s var(--ease) both;
    }
  }
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mark::before,
    .mark::after,
    details::details-content {
      transition: none;
    }
    details[open] .answer {
      animation: none;
    }
  }
</style>
