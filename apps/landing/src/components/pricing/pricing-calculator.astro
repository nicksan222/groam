---
import { env } from '@groam/env/landing';
import { calculator, resultCopy } from '@/content/pricing';
import PageSection from '@/components/page-section.astro';

const initialInvited = 3;
const initial = resultCopy(initialInvited);
const initials = ['J', 'P', 'S'];
---

<PageSection tone="bill" class="calc" aria-labelledby="calc-title" data-pricing-calculator>
    <h2 class="section-title" id="calc-title">{calculator.heading}</h2>

    <div class="surface sheet">
      <div class="row">
        <div class="what">
          <label for="calc-invited">{calculator.invited.label}</label>
          <p class="fine" id="calc-invited-hint">{calculator.invited.hint}</p>
        </div>
        <div class="stepper">
          <button type="button" class="step" data-step="invited" data-dir="-1" aria-label="One fewer traveler invited" aria-controls="calc-invited">−</button>
          <input id="calc-invited" type="range" min="0" max="30" step="1" value={initialInvited} aria-valuetext={`${initialInvited} travelers invited`} aria-describedby="calc-invited-hint" data-input="invited" />
          <button type="button" class="step" data-step="invited" data-dir="1" aria-label="One more traveler invited" aria-controls="calc-invited">+</button>
          <output class="value" for="calc-invited" data-value="invited">{initialInvited}</output>
        </div>
      </div>

      <div class="row total-row">
        <p class="sentence" aria-live="polite" aria-atomic="true">
          <strong data-total>{initial.total}</strong>
          <span data-rest>{initial.rest}</span>
        </p>
        <p class="figure" aria-hidden="true">
          <span class="pasted" data-figure><span class="fig-text">€{initialInvited}</span></span>
        </p>
      </div>

      <ul class="roster" aria-label="People on this trip" data-roster>
        <li class="person organizer">
          <span class="avatar avatar-maya big" aria-hidden="true">M</span>
          <span class="spacer" aria-hidden="true"></span>
          <span class="status">Trip creator</span>
        </li>
        {
          Array.from({ length: initialInvited }, (_, i) => (
            <li class="person paid">
              <span class={`avatar big c${i % 6}`} aria-hidden="true">{initials[i]}</span>
              <span class="status">Pays own €1</span>
            </li>
          ))
        }
      </ul>

      <div class="foot">
        <p class="fine">{calculator.footnote}</p>
        <a class="btn btn-primary" href={env.appUrl}>Start a trip</a>
      </div>
    </div>
</PageSection>

<script>
  import { initPricingCalculator } from '@/scripts/pricing-calculator';

  for (const el of document.querySelectorAll<HTMLElement>('[data-pricing-calculator]')) initPricingCalculator(el);
</script>

<style>
  .calc {
  }
  .sheet {
    display: grid;
    padding: 0 clamp(16px, 3vw, 36px) clamp(16px, 3vw, 28px);
  }
  p,
  li {
    text-wrap: pretty;
  }
  .section-title {
    text-wrap: balance;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 14px clamp(20px, 4vw, 56px);
    align-items: center;
    padding-block: 22px;
    border-bottom: 1.5px solid var(--ink-line);
  }
  .what .fine {
    text-wrap: balance;
  }
  .what {
    display: grid;
    gap: 4px;
  }
  label {
    font-weight: 800;
    font-stretch: 78%;
    font-size: 1.3rem;
    line-height: 1.1;
    text-transform: uppercase;
    word-spacing: var(--caps-space);
  }
  .stepper {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 12px;
  }
  .step {
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid var(--ink);
    background: var(--paper-raised);
    color: var(--ink);
    font: 800 22px/1 var(--font-sans);
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .step:hover:not([aria-disabled='true']) {
    background: var(--ink);
    color: var(--paper);
  }
  .step[aria-disabled='true'] {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .value {
    min-width: 2ch;
    text-align: end;
    font-weight: 850;
    font-stretch: 66%;
    font-size: 2.6rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  input[type='range'] {
    width: 100%;
    min-width: 0;
    height: 2.75rem;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-runnable-track {
    height: 6px;
    background: var(--ink);
  }
  input[type='range']::-moz-range-track {
    height: 6px;
    background: var(--ink);
  }
  input[type='range']::-webkit-slider-thumb {
    appearance: none;
    width: 18px;
    height: 30px;
    margin-top: -12px;
    border: 2px solid var(--ink);
    border-radius: 0;
    background: var(--bill);
  }
  input[type='range']::-moz-range-thumb {
    width: 14px;
    height: 26px;
    border: 2px solid var(--ink);
    border-radius: 0;
    background: var(--bill);
  }
  :is(.step, input):focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .total-row {
    border-bottom: var(--rule) solid var(--ink);
    padding-block: 28px;
  }
  .sentence {
    position: relative;
    display: grid;
    gap: 6px;
    max-width: 34ch;
    min-height: 5.4rem;
    align-content: start;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .sentence strong {
    color: var(--ink);
    font-size: 1.5rem;
    font-weight: 800;
    font-stretch: 80%;
  }
  .figure {
    justify-self: end;
  }
  .pasted {
    position: relative;
    display: inline-block;
    min-width: 1.65em;
    padding: 0.04em 0.14em 0;
    background: var(--strip);
    color: var(--strip-ink);
    text-align: center;
    font-weight: 850;
    font-stretch: 62%;
    font-size: clamp(5.5rem, 12vw, 10rem);
    line-height: 0.82;
    font-variant-numeric: tabular-nums;
  }
  .fig-text {
    display: block;
  }
  .roster {
    position: relative;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
    gap: 16px 10px;
    align-items: start;
    align-content: start;
    padding-block: 22px;
    border-bottom: 1.5px solid var(--ink-line);
  }
  .roster :global(.person) {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 8px;
    animation: person-in 0.5s var(--ease) backwards;
    animation-delay: var(--d, 0ms);
  }
  .roster :global(.person.leaving) {
    animation: person-out 0.4s var(--ease) forwards;
    animation-delay: var(--d, 0ms);
    pointer-events: none;
  }
  .roster :global(.status) {
    font-weight: 750;
    font-stretch: 82%;
    font-size: 12px;
    line-height: 1.25;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
    word-spacing: var(--caps-space);
    white-space: nowrap;
    color: var(--ink-soft);
  }
  .roster :global(.spacer) {
    height: 44px;
  }
  .roster :global(.pay) {
    width: 100%;
    min-height: 44px;
    padding: 0 6px;
    border: 2px solid var(--ink);
    background: transparent;
    color: var(--ink);
    font-weight: 750;
    font-stretch: 82%;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    word-spacing: var(--caps-space);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .roster :global(.pay:hover:not([aria-pressed='true'])) {
    background: var(--muted);
  }
  .roster :global(.pay[aria-pressed='true']) {
    background: var(--ink);
    color: var(--paper);
  }
  .roster :global(.pay[aria-pressed='true']:hover) {
    background: var(--ink-soft);
  }
  .roster :global(.pay:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .roster :global(.big) {
    width: 40px;
    height: 40px;
    font-size: 15px;
  }
  .roster :global(.c0) { background: var(--avatar-green); color: var(--avatar-green-foreground); }
  .roster :global(.c1) { background: var(--avatar-mauve); color: var(--avatar-mauve-foreground); }
  .roster :global(.c2) { background: var(--avatar-peach); color: var(--avatar-peach-foreground); }
  .roster :global(.c3) { background: var(--avatar-sky); color: var(--avatar-sky-foreground); }
  .roster :global(.c4) { background: var(--avatar-pink); color: var(--avatar-pink-foreground); }
  .roster :global(.c5) { background: var(--agent); color: var(--agent-ink); }
  @keyframes person-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes person-out {
    to {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 22px;
  }
  @media (max-width: 420px) {
    .stepper {
      grid-template-columns: auto auto minmax(0, 1fr);
    }
    .stepper input {
      grid-row: 2;
      grid-column: 1 / -1;
    }
    .value {
      grid-row: 1;
      grid-column: 3;
    }
  }
  @media (max-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    .figure {
      justify-self: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .roster :global(.person),
    .roster :global(.person.leaving) {
      animation: none;
    }
  }
</style>
