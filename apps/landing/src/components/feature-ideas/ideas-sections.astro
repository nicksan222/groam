---
import IdeaHeading from '@/components/idea-heading.astro';
import PageSection from '@/components/page-section.astro';
import { sections, splitRows } from '@/content/feature-ideas';
---

<PageSection>
  <section class="split-sec" data-reveal aria-labelledby="ideas-split">
      <div class="text">
        <h2 id="ideas-split" data-reveal-item>{sections.split.title}</h2>
        <p data-reveal-item>{sections.split.body}</p>
      </div>
      <div class="cmp" data-split data-reveal-item>
        <div class="seg" role="group" aria-label="Plan version" data-seg>
          <button type="button" data-mode-btn="live" aria-pressed="false">Live plan</button>
          <button type="button" data-mode-btn="idea" aria-pressed="true">With this idea</button>
        </div>
        <div class="stage" data-mode="idea">
          <ol class="layer base bill" aria-label="Live plan, Saturday">
            <li class="tag"><b>Live plan</b></li>
            {
              splitRows.map((row) => (
                <li class:list={['r', row.left ? 'solid' : 'blank']}>
                  {row.left && <span class="time">{row.time}</span>}
                  {row.left}
                </li>
              ))
            }
          </ol>
          <ol class="layer over strip flush" aria-label="Saturday with this idea" data-over>
            <li class="tag"><b>With this idea</b></li>
            {
              splitRows.map((row) => (
                <li class:list={['r', row.right ? (row.both ? 'solid' : 'dashed') : 'blank']}>
                  {row.right && <span class="time">{row.time}</span>}
                  {row.right}
                </li>
              ))
            }
          </ol>
          <span class="divider" aria-hidden="true" data-divider></span>
          <span class="grip" aria-hidden="true"></span>
          <input
            class="slide"
            type="range"
            min="0"
            max="100"
            value="35"
            aria-label="Compare the live plan with this idea"
            data-slide />
        </div>
        <p class="fine"><span class="hint-wide">{sections.split.hint}</span><span class="hint-phone">{sections.split.phoneHint}</span> <span class="example-label">Example trip</span></p>
      </div>
  </section>

  <div class="short">
    {
      sections.short.map((section, n) => (
        <section data-reveal>
          <h2 data-reveal-item><IdeaHeading flush={n === 1}>{section.title}</IdeaHeading></h2>
          <p data-reveal-item>{section.body}</p>
        </section>
      ))
    }
  </div>
</PageSection>

<script>
  import { splitCompare } from '@/scripts/feature-ideas-split';
  import { revealSections } from '@/scripts/feature-ideas-reveal';

  for (const root of document.querySelectorAll<HTMLElement>('[data-split]')) splitCompare(root);
  revealSections(document.querySelectorAll<HTMLElement>('[data-reveal]'));
</script>

<style>
  .split-sec {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
  }
  .text {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 20px clamp(24px, 5vw, 80px);
    align-items: end;
    padding-top: 22px;
    border-top: var(--rule) solid var(--ink);
  }
  .split-sec h2 {
    font-weight: 850;
    font-stretch: 62%;
    word-spacing: var(--caps-space);
    text-transform: uppercase;
    font-size: clamp(2.8rem, 7vw, 6.2rem);
    line-height: 0.88;
  }
  .text p {
    max-width: 44ch;
    color: var(--ink-soft);
    font-size: 1.12rem;
  }
  .cmp {
    display: grid;
    gap: 12px;
  }
  .cmp > p {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 14px;
  }
  .stage {
    position: relative;
    display: grid;
    overflow: hidden;
    touch-action: pan-y;
    border: 2px solid var(--ink);
  }
  .layer {
    grid-area: 1 / 1;
    display: grid;
    align-content: start;
    grid-auto-rows: auto;
    gap: 0;
    padding: clamp(12px, 2vw, 28px) clamp(14px, 3vw, 44px);
  }
  .layer.over {
    clip-path: inset(0 0 0 var(--cut, 50%));
    outline: 0;
    box-shadow: none;
    transform: none;
  }
  .tag {
    display: block;
    align-self: start;
    font-weight: 850;
    font-stretch: 62%;
    word-spacing: var(--caps-space);
    text-transform: uppercase;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    padding-bottom: 6px;
  }
  .over .tag {
    text-align: right;
  }
  .r {
    min-height: 64px;
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    border-top: 1.5px solid var(--on-line);
    font-size: clamp(15px, 1.5vw, 18px);
    font-weight: 650;
  }
  .r .time {
    color: inherit;
    font-size: clamp(20px, 2.4vw, 30px);
    font-weight: 800;
    font-stretch: 78%;
  }
  .over .r {
    grid-template-columns: minmax(0, 1fr) 5.2rem;
    text-align: right;
    border-top-color: color-mix(in srgb, var(--strip-ink) 40%, transparent);
  }
  .over .r .time {
    order: 2;
  }
  .r.blank {
    border-top-color: transparent;
  }
  .over .r:not(.blank) {
    padding-inline: 14px;
  }
  .over .r.dashed {
    outline: 2px dashed color-mix(in srgb, var(--strip-ink) 55%, transparent);
    outline-offset: -6px;
  }
  .divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--cut, 50%);
    width: 0;
    border-left: 3px dashed var(--strip-ink);
    margin-left: -1.5px;
    pointer-events: none;
  }
  .grip {
    position: absolute;
    top: 50%;
    left: clamp(15px, var(--cut, 50%), calc(100% - 15px));
    width: 30px;
    height: 56px;
    margin: -28px 0 0 -15px;
    background: var(--ink);
    border: 2px solid var(--strip);
    pointer-events: none;
}
  .grip::before,
  .grip::after {
    content: '';
    position: absolute;
    left: 7px;
    right: 7px;
    height: 2px;
    background: var(--strip);
  }
  .grip::before {
    top: 22px;
  }
  .grip::after {
    top: 30px;
  }
  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .stage:has(.slide:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .seg {
    display: none;
    gap: 0;
  }
  .seg button {
    flex: 1;
    min-height: 44px;
    border: 2px solid var(--ink);
    margin-right: -2px;
    background: transparent;
    color: var(--ink);
    font: 800 14px/1 var(--font-sans);
    font-stretch: 84%;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .seg button {
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .seg button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .seg button:focus-visible {
    outline: 3px solid var(--bill);
    outline-offset: 2px;
  }
  .short {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px clamp(24px, 5vw, 80px);
    padding-top: 28px;
    border-top: var(--rule) solid var(--ink);
  }
  .short h2 {
    font-weight: 850;
    font-stretch: 62%;
    word-spacing: var(--caps-space);
    text-transform: uppercase;
    font-size: clamp(2.2rem, 4.6vw, 4rem);
    line-height: 0.95;
  }
  .short p {
    margin-top: 18px;
    max-width: 40ch;
    color: var(--ink-soft);
    font-size: 1.08rem;
  }
  .hint-phone {
    display: none;
  }
  @media (max-width: 860px) {
    .text,
    .short {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .hint-wide,
    .over .tag,
    .r.blank {
      display: none;
    }
    .hint-phone {
      display: inline;
    }
    .r {
      min-height: 56px;
    }
    .seg {
      display: flex;
    }
    .slide,
    .grip,
    .divider {
      display: none;
    }
    .layer.over {
      clip-path: none;
      padding-left: clamp(14px, 3vw, 44px);
    }
    .over .r {
      grid-template-columns: 4.4rem minmax(0, 1fr);
      text-align: left;
    }
    .over .r .time {
      order: 0;
    }
    .layer {
      transition:
        opacity 0.45s var(--ease),
        transform 0.55s var(--ease),
        visibility 0s linear 0s;
    }
    .stage[data-mode='live'] .over,
    .stage[data-mode='idea'] .base {
      opacity: 0;
      visibility: hidden;
      transform: translateY(8px);
      pointer-events: none;
      transition-delay: 0s, 0s, 0.55s;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .layer,
    .seg button {
      transition: none;
    }
    .stage[data-mode='live'] .over,
    .stage[data-mode='idea'] .base {
      transition: none;
    }
  }
</style>
