---
import AuthorAvatar from '@/components/author-avatar.astro';
import Icon from '@/components/icon.astro';
import {
  approvalStatus,
  demoStrings,
  diffLines,
  planRows,
  stepCopy,
  stepLabels,
  trainLine,
  trainTime,
  type IdeaState
} from '@/content/feature-ideas';

// The first still frame (and reduced-motion) shows the finished idea: Applied.
const initial: IdeaState = 'applied';
const states = Object.keys(stepLabels) as IdeaState[];
const rowsInitial = [...planRows].sort((x, y) => x.time.localeCompare(y.time));
const people = ['jonas', 'priya', 'sam'] as const;
---

<figure class="demo-ideas" data-ideas data-state={initial} data-view="idea">
  <div class="bar">
    <div class="steps" role="group" aria-label="Idea status">
      {
        states.map((state) => (
          <button type="button" class="step" data-step={state} aria-pressed={state === initial ? 'true' : 'false'}>
            {stepLabels[state]}
          </button>
        ))
      }
    </div>
  </div>

  <div class="board surface">
    <article class="idea" aria-label="Example idea: Swap Belém for Sintra">
      <header class="head">
        <AuthorAvatar author="maya" />
        <div class="title">
          <h2>{demoStrings.title}</h2>
          <p class="fine">{demoStrings.byline}</p>
        </div>
        <span class="chip chip-done status" data-status>{stepLabels[initial]}</span>
    <button type="button" class="btn btn-ghost play" data-toggle hidden aria-pressed="false">
      <Icon name="pause" class="i-pause" />
      <Icon name="play" class="i-play" />
      <span class="play-label">Pause</span>
    </button>
      </header>

      <ul class="diff" aria-label="Itinerary changes in this idea">
        {
          diffLines.map((line, index) => (
            <li class:list={['line', line.kind]} data-line>
              <span class="sign" aria-hidden="true">
                {line.kind === 'add' ? '+' : '−'}
              </span>
              <span class="time" data-time={index === trainLine ? '' : undefined}>
                {index === trainLine ? trainTime[initial] : line.time}
              </span>
              <span class="label">
                <span class="sr">{line.kind === 'add' ? 'Added: ' : 'Removed: '}</span>
                {line.title}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="note" data-note>
        <AuthorAvatar author="itinerary-agent" />
        <span><b>{demoStrings.agentName}</b> {demoStrings.agentNote}</span>
      </p>

      <ul class="votes" aria-label="Approvals">
        {
          people.map((person) => (
            <li data-person={person} data-on={approvalStatus[initial][person].on ? 'true' : 'false'}>
              <AuthorAvatar author={person} />
              <span data-vote-text>{approvalStatus[initial][person].text}</span>
            </li>
          ))
        }
      </ul>

      <p class="status-line" data-live aria-live="polite">{stepCopy[initial]}</p>

      <div class="actions">
        <span data-decide hidden>
          <button type="button" class="btn btn-primary" data-approve>
            <Icon name="check" />
            {demoStrings.approve}
          </button>
          <button type="button" class="btn btn-outline" data-request>{demoStrings.request}</button>
        </span>
        <span class="stamp" data-stamp><Icon name="check" />{demoStrings.stamp}</span>
        <button type="button" class="btn btn-ghost" data-reset>{demoStrings.reset}</button>
      </div>
    </article>

    <section class="plan" aria-label="Saturday itinerary">
      <div class="plan-head">
        <h2>{demoStrings.livePlan}</h2>
      </div>
      <ol class="rows" data-rows>
        {
          rowsInitial.map((row) => (
            <li class="row" data-row={row.id} data-origin={row.origin} data-mode={row.origin === 'old' ? 'gone' : 'solid'}>
              <div class="row-in">
                <span class="time" data-row-time>
                  {row.time}
                </span>
                <span class="row-label">{row.label}</span>
                <span class="tag" data-tag />
              </div>
            </li>
          ))
        }
      </ol>
      <p class="unchanged fine">+1 unchanged: {planRows.find((row) => row.origin === 'both')?.label}</p>
      <p class="legend fine">
        <span class="key key-solid" aria-hidden="true"></span>Agreed
        <span class="key key-dashed" aria-hidden="true"></span>Proposed, not yet in the plan
      </p>
    </section>
  </div>

  <figcaption>
    <span class="example-label">Example trip</span>
    <span>{demoStrings.caption}</span>
  </figcaption>
</figure>

<script>
  import { playIdeasDemo } from '@/scripts/feature-ideas-demo';

  for (const root of document.querySelectorAll<HTMLElement>('[data-ideas]')) playIdeasDemo(root);
</script>

<style>
  .demo-ideas {
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .steps {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    background: var(--muted);
    border-radius: calc(var(--radius) + 3px);
    max-width: 100%;
    flex-wrap: wrap;
  }
  .step,
  .view button {
    position: relative;
    height: 2rem;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted-foreground);
    font: 500 13.5px/1 var(--font-sans);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .step[aria-pressed='true'],
  .view button[aria-pressed='true'] {
    background: var(--background);
    color: var(--foreground);
    box-shadow: var(--shadow-xs);
  }
  .step:focus-visible,
  .view button:focus-visible,
  .play:focus-visible,
  .actions .btn:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .step::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: var(--primary);
    transform: scaleX(0);
    transform-origin: left;
  }
  .demo-ideas[data-running='true'] .step[aria-pressed='true']::after {
    animation: fill var(--step-ms, 3800ms) linear forwards;
  }
  @keyframes fill {
    to {
      transform: scaleX(1);
    }
  }
  .play :global(svg) {
    width: 14px;
    height: 14px;
  }
  .play[hidden] {
    display: none;
  }
  .play[aria-pressed='false'] :global(.i-play),
  .play[aria-pressed='true'] :global(.i-pause) {
    display: none;
  }

  .board {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    overflow: hidden;
  }
  .idea {
    display: grid;
    gap: 16px;
    padding: clamp(16px, 2.4vw, 28px);
    border-right: 1px solid var(--border);
    align-content: start;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .head :global(.avatar) {
    width: 32px;
    height: 32px;
  }
  .title {
    flex: 1 1 auto;
    min-width: 0;
  }
  .title h2 {
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }
  .status {
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .demo-ideas[data-state='proposed'] .status {
    background: var(--primary-soft);
    color: var(--primary-ink);
  }
  .demo-ideas[data-state='changes'] .status {
    background: color-mix(in srgb, var(--warning) 20%, var(--background));
    color: var(--foreground);
  }

  .diff {
    display: grid;
    gap: 6px;
  }
  .line {
    display: grid;
    grid-template-columns: 16px 44px minmax(0, 1fr);
    gap: 8px;
    align-items: baseline;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 14.5px;
  }
  .line.add {
    background: color-mix(in srgb, var(--success) 12%, var(--background));
  }
  .line.remove {
    background: color-mix(in srgb, var(--destructive) 9%, var(--background));
  }
  .line.remove .label {
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--destructive) 55%, transparent);
  }
  .sign {
    font: 600 14px/1 var(--font-mono);
  }
  .add .sign {
    color: var(--success);
  }
  .remove .sign {
    color: var(--destructive);
  }
  .note {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 10px 12px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--avatar-sky) 28%, var(--background));
    font-size: 13.5px;
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .demo-ideas[data-state='proposed'] .note {
    opacity: 0.35;
    transform: translateY(4px);
  }
  .votes {
    display: grid;
    gap: 8px;
  }
  .votes li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    transition: color 0.3s ease;
  }
  .votes :global(.avatar) {
    transition:
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s ease;
  }
  .votes li[data-on='false'] {
    color: var(--muted-foreground);
  }
  .votes li[data-on='false'] :global(.avatar) {
    background: transparent;
    color: var(--muted-foreground);
    box-shadow: none;
    border: 1px dashed var(--muted-foreground);
  }
  .stamp {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 6px;
    color: var(--muted-foreground);
    font-size: 14px;
  }
  .stamp :global(svg) {
    width: 15px;
    height: 15px;
    color: var(--success);
  }
  [data-decide],
  .stamp {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  [data-decide][hidden],
  .stamp[hidden] {
    display: none;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .actions .btn :global(svg) {
    width: 15px;
    height: 15px;
  }

  .plan {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: clamp(16px, 2.4vw, 28px);
    background: var(--canvas);
  }
  .plan-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .plan-head h2 {
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }
  .view {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    background: var(--muted);
    border-radius: calc(var(--radius) + 3px);
  }
  .demo-ideas[data-state='applied'] .view {
    opacity: 0.55;
  }
  .rows {
    display: grid;
  }
  .row {
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s ease;
  }
  .row[data-mode='gone'] {
    grid-template-rows: 0fr;
    opacity: 0;
  }
  .row-in {
    overflow: hidden;
    min-height: 0;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    margin-bottom: 8px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
    font-size: 14.5px;
    transition:
      background-color 0.4s ease,
      border-color 0.4s ease,
      color 0.4s ease;
  }
  .row[data-mode='gone'] .row-in {
    margin-bottom: 0;
    padding-block: 0;
    border-width: 0;
  }
  .row[data-mode='dashed'] .row-in {
    border: 1px dashed var(--muted-foreground);
    background: transparent;
    color: var(--muted-foreground);
  }
  .row[data-mode='struck'] .row-in {
    border-style: dashed;
    color: var(--muted-foreground);
    background: transparent;
  }
  .row[data-mode='struck'] .row-label {
    text-decoration: line-through;
  }
  .tag {
    font-size: 12px;
    color: var(--muted-foreground);
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .key {
    display: inline-block;
    width: 22px;
    height: 12px;
    border-radius: 3px;
  }
  .key-solid {
    border: 1px solid var(--border);
    background: var(--card);
  }
  .key-dashed {
    margin-left: 10px;
    border: 1px dashed var(--muted-foreground);
  }

  .status-line {
    margin: 0;
    min-height: 3em;
    font-weight: 500;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    color: var(--muted-foreground);
    font-size: 14px;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 360px) {
    .head {
      flex-wrap: wrap;
    }
    .title {
      flex-basis: calc(100% - 48px);
    }
    .status {
      margin-left: 44px;
    }
  }
  .unchanged {
    display: none;
    margin: 0;
  }
  @media (max-width: 640px) {
    .head .play {
      flex: none;
      width: 32px;
      min-width: 32px;
      height: 32px;
      padding: 0;
      justify-content: center;
    }
    .head .play-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .row[data-origin='both'] {
      display: none;
    }
    .unchanged {
      display: block;
    }
  }
  @media (max-width: 860px) {
    .board {
      grid-template-columns: minmax(0, 1fr);
    }
    .idea {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row,
    .row-in,
    .note,
    .votes :global(.avatar),
    .status {
      transition: none;
    }
  }
</style>
