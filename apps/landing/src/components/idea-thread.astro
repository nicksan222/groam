---
import AuthorAvatar from '@/components/author-avatar.astro';
import Icon from '@/components/icon.astro';
import { sintraIdea } from '@/content/example-trip';
import { ideaChanges, ideaSteps, ideaStates, proposedTrainTime } from '@/content/idea-thread';
---

<section class="wrap idea" id="idea" data-idea data-states={JSON.stringify(ideaStates)}>
  <div class="intro">
    <h2 class="section-title">Nothing changes until someone applies it</h2>
    <p class="section-lede">Follow one change on the example trip. Maya wants Saturday in Sintra instead of Belém.</p>
    <ol class="steps">
      {
        ideaSteps.map((step, index) => (
          <li class:list={{ active: index === ideaSteps.length - 1, done: index < ideaSteps.length - 1 }}>
            <h3>
              <button type="button" data-step-button aria-current={index === ideaSteps.length - 1 ? 'step' : undefined}>
                {step.title}
              </button>
            </h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
    <button class="autoplay" type="button" data-autoplay aria-pressed="false" hidden>
      <Icon name="pause" class="when-playing" />
      <Icon name="play" class="when-paused" />
      <span class="when-playing">Pause the walkthrough</span>
      <span class="when-paused">Play the walkthrough</span>
    </button>
  </div>

  <article class="surface card" aria-label="Example idea: Swap Belém for Sintra" data-card data-step="2">
    <header class="card-head">
      <AuthorAvatar author="maya" />
      <div>
        <h3>Swap Belém for Sintra</h3>
        <p class="fine">Idea by Maya · Lisbon long weekend</p>
      </div>
      <span class="chip chip-done" data-chip>Applied</span>
    </header>

    <ul class="changes" aria-label="Itinerary changes">
      {
        ideaChanges.map((change, index) => (
          <li class:list={['change', change.kind]} style={`--n: ${index}`}>
            <span class="sign" aria-hidden="true">{change.kind === 'add' ? '+' : '−'}</span>
            <span class="time" data-early={change.label.startsWith('Train to Sintra') ? proposedTrainTime : undefined} data-final={change.time}>{change.time}</span>
            <span class="label">
              <span class="visually-hidden">{change.kind === 'add' ? 'Added: ' : 'Removed: '}</span>
              {change.label}
            </span>
          </li>
        ))
      }
    </ul>

    <div class="review">
     <div class="review-inner">
      <div class="agent-note">
        <AuthorAvatar author="itinerary-agent" />
        <p><b>Itinerary agent</b> {sintraIdea.agentNote}</p>
      </div>
      <ul class="votes">
        <li style="--n: 0"><AuthorAvatar author="jonas" />Jonas approved</li>
        <li style="--n: 1"><AuthorAvatar author="priya" />Priya approved</li>
        <li style="--n: 2"><AuthorAvatar author="sam" />Sam approved once the train moved to 09:30</li>
      </ul>
     </div>
    </div>

    <footer class="card-foot">
      <span class="example-label">Example trip</span>
      <span class="time" data-foot>Applied {sintraIdea.appliedAt}</span>
    </footer>
  </article>
</section>

<script>
  import { initIdeaThread } from '@/scripts/home-idea';

  for (const root of document.querySelectorAll<HTMLElement>('[data-idea]')) initIdeaThread(root);
</script>

<style>
  .idea {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
    padding-block: clamp(64px, 9vw, 128px);
  }
  .steps {
    margin-top: 40px;
    display: grid;
    gap: 0;
    counter-reset: step;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    column-gap: 16px;
    padding-block: 16px;
    border-top: 1px solid var(--border);
  }
  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--primary-soft);
    color: var(--primary-ink);
    font: 600 12px/1 var(--font-mono);
  }
  .steps li {
    position: relative;
    cursor: pointer;
  }
  .steps li::before {
    transition:
      background 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .steps li.active::before,
  .steps li.done::before {
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .steps li:not(.active) h3 button {
    color: var(--muted-foreground);
  }
  .steps li::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--primary);
    transform: scaleX(0);
    transform-origin: left;
  }
  .idea:global(.playing.bar) .steps li.active::after {
    animation: dwell 3600ms linear both;
  }
  @keyframes dwell {
    to {
      transform: none;
    }
  }
  .steps h3 {
    font-size: 1.05rem;
  }
  .steps h3 button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--foreground);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    border-radius: 4px;
  }
  .steps h3 button:hover {
    color: var(--primary);
  }
  .autoplay {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    padding: 6px 12px 6px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--background);
    color: var(--muted-foreground);
    font: inherit;
    font-size: 13.5px;
    cursor: pointer;
  }
  .autoplay:hover {
    color: var(--foreground);
    background: var(--muted);
  }
  .autoplay[hidden] {
    display: none;
  }
  .autoplay :global(svg) {
    width: 14px;
    height: 14px;
  }
  .autoplay .when-paused,
  .idea:global(.autoplay-off) .autoplay .when-playing {
    display: none;
  }
  .idea:global(.autoplay-off) .autoplay .when-paused {
    display: inline;
  }
  .idea:global(.autoplay-off) .autoplay :global(svg.when-paused) {
    display: block;
  }
  .autoplay :global(svg.when-paused),
  .idea:global(.autoplay-off) .autoplay :global(svg.when-playing) {
    display: none;
  }
  .idea:global(.autoplay-off) .autoplay :global(svg.when-paused) {
    display: block;
  }
  /* State of the card per step: 0 Propose, 1 Review, 2 Apply. */
  .change {
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      outline-color 0.5s;
    transition-delay: calc(var(--n) * 90ms);
    outline: 1px dashed transparent;
  }
  .card[data-step='0'] .change,
  .card[data-step='1'] .change {
    outline-color: var(--border);
  }
  .card[data-step='0'] .change.add {
    background: color-mix(in srgb, var(--success) 9%, var(--background));
  }
  .review {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .review-inner {
    display: grid;
    gap: 12px;
    min-height: 0;
    overflow: hidden;
  }
  .agent-note,
  .votes li {
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .votes li {
    transition-delay: calc(0.25s + var(--n) * 180ms);
  }
  .card[data-step='0'] .agent-note,
  .card[data-step='0'] .votes li {
    opacity: 0;
    transform: translateY(10px);
    transition-delay: 0s;
  }
  .card[data-step='1'] .votes li:last-child {
    opacity: 0.5;
  }
  .steps h3 button:focus-visible,
  .autoplay:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .steps p {
    margin-top: 4px;
    color: var(--muted-foreground);
    font-size: 15px;
    max-width: 44ch;
  }
  .card {
    overflow: hidden;
    align-self: start;
  }
  .card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--border);
  }
  .card-head h3 {
    font-size: 1.05rem;
  }
  .card-head .chip {
    margin-left: auto;
  }
  .changes {
    display: grid;
    gap: 6px;
    padding: 14px 18px;
  }
  .change {
    display: grid;
    grid-template-columns: 12px 72px minmax(0, 1fr);
    gap: 10px;
    align-items: baseline;
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 14px;
  }
  .change .sign {
    font: 600 14px/1 var(--font-mono);
  }
  .change.add {
    background: var(--success-soft);
  }
  .change.add .sign {
    color: var(--success);
  }
  .change.remove {
    background: color-mix(in srgb, var(--destructive) 9%, var(--background));
    color: var(--muted-foreground);
  }
  .change.remove .sign {
    color: var(--destructive);
  }
  .review {
    padding-inline: 18px;
  }
  .review-inner {
    padding-block: 4px 16px;
  }
  .agent-note {
    display: flex;
    gap: 10px;
    padding: 12px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--avatar-sky) 20%, var(--card, var(--background)));
    color: var(--foreground);
    font-size: 14px;
  }
  .agent-note b {
    display: block;
    font-weight: 600;
  }
  .votes {
    display: grid;
    gap: 10px;
    font-size: 14px;
  }
  .votes li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border-top: 1px solid var(--border);
    background: var(--canvas);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .idea {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 420px) {
    .change {
      grid-template-columns: 12px minmax(0, 1fr);
    }
    .change .time,
    .change .label {
      grid-column: 2;
    }
  }
</style>
