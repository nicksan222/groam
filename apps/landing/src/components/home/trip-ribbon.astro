---
import Icon from '@/components/icon.astro';
import { exampleTrips } from '@/content/home-trips';
---

<section class="ribbon" aria-labelledby="ribbon-label" data-ribbon>
  <div class="row">
  <div class="viewport">
    <div class="belt">
      {
        [false, true].map((duplicate) => (
          <ul class="track" aria-hidden={duplicate ? 'true' : undefined} data-duplicate={duplicate || undefined}>
            {exampleTrips.map((trip) => (
              <li class="trip">
                <span class="cover" style={`--tone: var(--avatar-${trip.tone}); --tone-ink: var(--avatar-${trip.tone}-foreground)`} aria-hidden="true">
                  {trip.name.slice(0, 1)}
                </span>
                <span class="name">{trip.name}</span>
                <span class="state">{trip.state}</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <div class="meta">
    <h2 id="ribbon-label" class="visually-hidden">Example trips</h2>
    <span class="example-label">Example trips</span>
    <button class="toggle" type="button" data-toggle aria-pressed="false" hidden>
      <Icon name="pause" class="when-playing" />
      <Icon name="play" class="when-paused" />
      <span class="visually-hidden">Pause the example trips ribbon</span>
    </button>
  </div>
  </div>
</section>

<script>
  import { initTripRibbon } from '@/scripts/home-ribbon';

  for (const ribbon of document.querySelectorAll<HTMLElement>('[data-ribbon]')) initTripRibbon(ribbon);
</script>

<style>
  .ribbon {
    --gap: 12px;
    padding-block: 24px;
    border-block: 1px solid var(--border);
    background: var(--canvas);
    overflow: hidden;
  }
  .row {
    display: flex;
    align-items: center;
  }
  .meta {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 10px;
    padding-inline: 14px var(--gutter, 16px);
    background: var(--canvas);
    position: relative;
    z-index: 1;
    box-shadow: -12px 0 12px -4px var(--canvas);
  }
  .toggle {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--background);
    color: var(--muted-foreground);
    cursor: pointer;
  }
  .toggle:hover {
    color: var(--foreground);
    background: var(--muted);
  }
  .toggle[hidden] {
    display: none;
  }
  .toggle :global(svg) {
    width: 14px;
    height: 14px;
  }
  .toggle :global(.when-paused),
  .ribbon.paused .toggle :global(.when-playing) {
    display: none;
  }
  .ribbon.paused .toggle :global(.when-paused) {
    display: block;
  }
  .viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .belt {
    display: flex;
    width: max-content;
    animation: slide 70s linear infinite;
    will-change: transform;
  }
  .viewport:hover .belt,
  .viewport:focus-within .belt,
  .ribbon.paused .belt,
  .ribbon.idle .belt {
    animation-play-state: paused;
  }
  .track {
    display: flex;
    gap: var(--gap);
    padding-right: var(--gap);
    margin: 0;
    padding-left: 0;
    list-style: none;
  }
  .trip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--background);
    font-size: 14px;
    white-space: nowrap;
    transition:
      border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .trip:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }
  .cover {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--tone);
    color: var(--tone-ink);
    font-size: 12px;
    font-weight: 600;
  }
  .name {
    font-weight: 600;
  }
  .state {
    color: var(--muted-foreground);
  }
  .state::before {
    content: '·';
    margin-right: 10px;
  }
  @keyframes slide {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .belt {
      animation: none;
      width: auto;
    }
    .track {
      flex-wrap: wrap;
      padding-inline: var(--gutter, 16px);
    }
    .track[data-duplicate] {
      display: none;
    }
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
