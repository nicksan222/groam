---
import Icon from '@/components/icon.astro';
import { caption, proposal, screens, steps, trip } from '@/content/feature-ai';

const [first] = screens;
const firstQa = first?.qas[0];
if (!first || !firstQa) throw new Error('feature-ai content is empty');
---

<figure class="demo" data-ai-demo>
  <div class="surface workspace" role="group" aria-label="Example workspace with the assistant docked on the right">
    <header class="bar">
      <b>{trip}</b>
      <span class="example-label">Example trip</span>
      <button class="pause" type="button" data-toggle hidden aria-pressed="false">
        <Icon name="pause" class="i-pause" />
        <Icon name="play" class="i-play" />
        <span class="visually-hidden">Pause the demo</span>
      </button>
    </header>

    <div class="body">
      <div class="nav" role="tablist" aria-label="Screen in view" aria-orientation="vertical">
        {
          screens.map((screen, n) => (
            <button
              class="tab"
              type="button"
              role="tab"
              id={`ai-tab-${screen.id}`}
              aria-controls={`ai-panel-${screen.id}`}
              aria-selected={n === 0}
              tabindex={n === 0 ? 0 : -1}
              data-screen={screen.id}
              data-context={screen.context}
            >
              {screen.label}
            </button>
          ))
        }
      </div>

      <div class="main">
        {
          screens.map((screen, n) => (
            <div
              class="panel"
              role="tabpanel"
              id={`ai-panel-${screen.id}`}
              aria-labelledby={`ai-tab-${screen.id}`}
              data-panel={screen.id}
              hidden={n !== 0}
            >
              <ul class="rows" aria-label={screen.label}>
                {screen.rows.map((row) => (
                  <li class:list={['row', n === 0 && firstQa.highlight.includes(row.id) && 'hl']} data-row={row.id}>
                    {row.time && <span class="time">{row.time}</span>}
                    <span class="label">{row.label}</span>
                    {row.note && <span class="fine">{row.note}</span>}
                  </li>
                ))}
                {screen.id === 'itinerary' && (
                  <li class="row proposal" data-proposal-row>
                    <span class="chip chip-idea">{proposal.label}</span>
                    <span class="label">{proposal.title} <span class="by">{proposal.by}</span></span>
                  </li>
                )}
              </ul>
            </div>
          ))
        }
      </div>

      <aside class="dock" aria-label="Assistant">
        <div class="dock-head">
          <span class="avatar avatar-agent"><Icon name="agent" /></span>
          <b>Assistant</b>
          <span class="fine">Private to you</span>
        </div>
        <p class="chip chip-agent context" aria-live="off">
          <span class="fine-label">Looking at</span>
          <span data-context-text>{first.context}</span>
        </p>
        <div class="thread">
          <p class="step">{steps.ask}</p>
          <p class="bubble me" data-question>{firstQa.question}</p>
          <p class="step">{steps.answer}</p>
          <div class="bubble bot" data-reply>
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span data-answer>{firstQa.answer}</span>
          </div>
        </div>
        <p class="visually-hidden" role="status" data-status>{firstQa.question} {firstQa.answer}</p>
        <div class="chips" role="group" aria-label="Suggested questions">
          {
            screens.flatMap((screen, n) =>
              screen.qas.map((qa, i) => (
                <button
                  class="ask"
                  type="button"
                  hidden={n !== 0}
                  aria-pressed={n === 0 && i === 0}
                  data-qa={`${screen.id}:${i}`}
                  data-question={qa.question}
                  data-answer={qa.answer}
                  data-highlight={qa.highlight.join(',')}
                  data-proposal={qa.proposal ? 'true' : undefined}
                >
                  {qa.question}
                </button>
              ))
            )
          }
        </div>
      </aside>
    </div>
  </div>
  <figcaption class="fine">{caption}</figcaption>
</figure>

<script>
  import { playAiDemo } from '@/scripts/feature-ai-demo';

  for (const demo of document.querySelectorAll<HTMLElement>('[data-ai-demo]')) playAiDemo(demo);
</script>

<style>
  .demo {
    margin: 0;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    display: grid;
    gap: 12px;
  }
  .workspace {
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--canvas);
  }
  .pause {
    margin-left: auto;
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--background);
    color: var(--foreground);
    cursor: pointer;
  }
  .pause[hidden] {
    display: none;
  }
  .pause:focus-visible,
  .tab:focus-visible,
  .ask:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .pause :global(svg) {
    width: 16px;
    height: 16px;
  }
  .pause :global(.i-play),
  .paused .pause :global(.i-pause) {
    display: none;
  }
  .paused .pause :global(.i-play) {
    display: block;
  }
  .body {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) minmax(280px, 340px);
  }
  .nav {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 12px;
    border-right: 1px solid var(--border);
  }
  .tab {
    padding: 8px 12px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted-foreground);
    font: inherit;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .tab:hover {
    background: var(--muted);
  }
  .tab[aria-selected='true'] {
    background: var(--primary-soft);
    color: var(--primary-ink);
  }
  .main {
    padding: 16px;
    min-width: 0;
    min-height: 0;
  }
  .panel[hidden] {
    display: none;
  }
  .rows {
    display: grid;
    gap: 8px;
  }
  .panel.arriving {
    animation: panel-in 0.5s var(--ease);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--background);
    transition: background-color 0.4s var(--ease), border-color 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .row:not(:has(.time)) {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .row.hl {
    background: var(--primary-soft);
    border-color: color-mix(in srgb, var(--primary) 45%, var(--border));
    transform: translateX(4px);
  }
  .label {
    font-weight: 500;
  }
  .row.proposal {
    grid-template-columns: auto minmax(0, 1fr);
    border-style: dashed;
    border-color: var(--input);
    background: color-mix(in srgb, var(--primary) 8%, var(--card));
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.5s var(--ease), transform 0.6s var(--ease);
  }
  .proposal.show {
    opacity: 1;
    transform: translateY(0);
  }
  .proposal .chip {
    justify-self: start;
  }
  .by {
    color: var(--muted-foreground);
    font-weight: 400;
  }
  .proposal::before {
    display: none;
  }
  .dock {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 16px;
    border-left: 1px solid var(--border);
    background: var(--canvas);
    min-width: 0;
  }
  .dock-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dock-head .fine {
    margin-left: auto;
  }
  .context {
    justify-self: start;
    gap: 8px;
    margin: 0;
    transition: opacity 0.3s ease;
  }
  .fine-label {
    opacity: 0.75;
  }
  .thread {
    display: grid;
    gap: 6px;
    min-height: 6.5rem;
    align-content: start;
  }
  .step {
    font-size: 12px;
    color: var(--muted-foreground);
    margin-top: 6px;
  }
  .bubble {
    padding: 10px 12px;
    border-radius: 12px;
    font-size: 14.5px;
    line-height: 1.45;
    min-height: 2.4em;
  }
  .me {
    background: var(--primary-soft);
    color: var(--primary-ink);
    border-top-right-radius: 4px;
  }
  .bot {
    position: relative;
    background: var(--background);
    border: 1px solid var(--border);
    border-top-left-radius: 4px;
    min-height: 4.4em;
  }
  .typing::after {
    content: '';
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: currentColor;
    animation: blink 0.9s steps(1) infinite;
  }
  .dots {
    display: none;
    gap: 4px;
    padding-block: 6px;
  }
  .thinking .dots {
    display: inline-flex;
  }
  .dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted-foreground);
    animation: dot 1s var(--ease) infinite;
  }
  .dots i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .dots i:nth-child(3) {
    animation-delay: 0.3s;
  }
  .chips {
    display: grid;
    gap: 6px;
  }
  .ask {
    padding: 7px 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--background);
    color: var(--foreground);
    font: inherit;
    font-size: 13px;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .ask[hidden] {
    display: none;
  }
  .ask:hover {
    border-color: var(--primary);
  }
  .ask[aria-pressed='true'] {
    border-color: var(--primary);
    background: var(--primary-soft);
    color: var(--primary-ink);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes dot {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    40% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }
  @media (max-width: 880px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    .nav {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    .tab {
      text-align: center;
    }
    .dock {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
    .thread {
      min-height: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel.arriving,
    .typing::after,
    .dots i {
      animation: none;
    }
    .row,
    .proposal,
  }
</style>
