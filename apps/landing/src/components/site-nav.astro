---
import { env } from '@groam/env/landing';
import BrandLink from '@/components/brand-link.astro';
import Icon from '@/components/icon.astro';
import { features, featurePath, primaryNav } from '@/content/site';

const path = Astro.url.pathname.replace(/\/$/u, '') || '/';
const isCurrent = (href: string) => {
  const base = href.replace(/\/$/u, '');
  return path === base || path.startsWith(`${base}/`);
};
---

<a class="skip" href="#content">Skip to content</a>
<header class="wrap nav">
  <BrandLink />
  <nav class="links" aria-label="Main">
    {
      primaryNav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="actions">
    <a class="btn btn-ghost sign-in" href={env.appUrl}>Sign in</a>
    <a class="btn btn-primary" href={env.appUrl}>Start a trip</a>
    <details class="menu" data-site-menu>
      <summary class="btn btn-outline" aria-label="Menu">
        <Icon name="menu" class="open-icon" />
        <Icon name="close" class="close-icon" />
      </summary>
      <div class="sheet surface">
        <a class="sheet-head" href="/features/" aria-current={isCurrent('/features/') && path === '/features' ? 'page' : undefined}>
          Features
        </a>
        <ul>
          {
            features.map((feature) => (
              <li>
                <a
                  href={featurePath(feature.slug)}
                  aria-current={isCurrent(featurePath(feature.slug)) ? 'page' : undefined}
                >
                  <Icon name={feature.icon} />
                  {feature.name}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="sheet-head" href="/pricing/" aria-current={isCurrent('/pricing/') ? 'page' : undefined}>
          Pricing
        </a>
        <a class="btn btn-outline" href={env.appUrl}>Sign in</a>
      </div>
    </details>
  </div>
</header>

<script>
  // Close the mobile menu on Escape (focus back on its toggle) and on a click outside it.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-site-menu]')) {
    const toggle = menu.querySelector('summary');
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      toggle?.focus();
    });
    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  }
</script>

<style>
  .skip {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 20;
    padding: 8px 12px;
    border-radius: var(--radius);
    background: var(--primary);
    color: var(--primary-foreground);
    font-weight: 500;
    text-decoration: none;
    transform: translateY(-160%);
  }
  .skip:focus-visible {
    transform: none;
  }
  .nav {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 28px;
    padding-block: 18px;
  }
  .links {
    display: flex;
    gap: 22px;
    font-size: 14px;
  }
  .links a {
    color: var(--muted-foreground);
    text-decoration: none;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--foreground);
  }
  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .menu {
    display: none;
  }
  .menu summary {
    width: 2.25rem;
    padding: 0;
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu :global(svg) {
    width: 18px;
    height: 18px;
  }
  .menu :global(.close-icon),
  .menu[open] :global(.open-icon) {
    display: none;
  }
  .menu[open] :global(.close-icon) {
    display: block;
  }
  .sheet {
    position: absolute;
    top: calc(100% - 4px);
    left: var(--gutter);
    right: var(--gutter);
    display: grid;
    gap: 6px;
    padding: 14px;
    box-shadow: var(--shadow-lg);
  }
  .sheet-head {
    padding: 8px 10px;
    color: var(--foreground);
    font-weight: 600;
    text-decoration: none;
  }
  .sheet ul {
    display: grid;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }
  .sheet li a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--radius);
    color: var(--muted-foreground);
    text-decoration: none;
  }
  .sheet li a[aria-current='page'],
  .sheet-head[aria-current='page'] {
    color: var(--primary-ink);
  }
  .sheet li a:hover {
    background: var(--muted);
    color: var(--foreground);
  }
  .sheet li :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--primary);
  }
  @media (max-width: 860px) {
    .links,
    .sign-in {
      display: none;
    }
    .menu {
      display: block;
    }
  }
</style>
