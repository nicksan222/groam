---
import ClosingCall from '@/components/closing-call.astro';
import ExampleJourney from '@/components/example-journey.astro';
import Hero from '@/components/hero.astro';
import RecordSection from '@/components/home/record-section.astro';
import TripRibbon from '@/components/home/trip-ribbon.astro';
import PricingTeaser from '@/components/pricing/pricing-teaser.astro';
import SiteFooter from '@/components/site-footer.astro';
import SiteNav from '@/components/site-nav.astro';
import TrackedKinds from '@/components/tracked-kinds.astro';
import { exampleJourneys } from '@/content/example-journeys';
import LandingLayout from '@/layouts/landing-layout.astro';
---

<LandingLayout
  title="Groam · Plan group trips together"
  description="A shared place where people and AI agents plan group trips. Every idea, review, and fix is on the record, so the group always knows what was decided."
>
  <SiteNav />
  <main id="content">
    <Hero />
    <TripRibbon />
    <TrackedKinds />
    <ExampleJourney journey={exampleJourneys.home} />
    <RecordSection />
    <PricingTeaser />
    <ClosingCall />
  </main>
  <SiteFooter />
</LandingLayout>
