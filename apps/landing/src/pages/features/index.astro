---
import HubExplorer from '@/components/features-hub/hub-explorer.astro';
import ClosingCall from '@/components/closing-call.astro';
import PageIntro from '@/components/page-intro.astro';
import PageSection from '@/components/page-section.astro';
import { hubClosing, hubDescription, hubHeadline, hubLede, hubTitle } from '@/content/features-hub';
import SubpageLayout from '@/layouts/subpage-layout.astro';
---

<SubpageLayout title={hubTitle} description={hubDescription}>
  <PageIntro title={hubHeadline} lede={hubLede} />
  <PageSection>
    <HubExplorer />
  </PageSection>
  <PageSection>
  <div class="together">
    <p><span>{hubClosing}</span></p>
  </div>
  </PageSection>
  <ClosingCall />
</SubpageLayout>

<style>
  .together {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--column-gap);
  }
  .together p {
    padding-top: 22px;
    border-top: var(--rule) solid var(--ink);
  }
  .together span {
    display: block;
    max-width: 24ch;
    font-weight: 850;
    font-stretch: 64%;
    word-spacing: var(--caps-space);
    text-transform: uppercase;
    font-size: clamp(2rem, 4.4vw, 3.8rem);
    line-height: 0.95;
    text-wrap: balance;
  }
  @media (max-width: 860px) {
    .together {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
