{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:3211/*", "http://localhost:3211/*", "http://localhost:5173/*"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-export-groam-data",
    "allow-groam-data-dir-path",
    "allow-import-groam-data"
  ]
}
