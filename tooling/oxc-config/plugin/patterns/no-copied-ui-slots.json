{
  "$schema": "../pattern.schema.json",
  "match": "node-text",
  "nodes": ["JSXAttribute"],
  "pattern": "data-slot=\"(?:stacked-avatar|muted-copy|icon-tile|icon-badge|removable-chip|error-well|form-field|form-section|form-actions|form|menu-row|dashed-empty|cover-frame|detail-section|settings-[a-z-]+|(?:card|dialog|sheet|popover|select|table|avatar|alert-dialog|attachment|dropdown-menu|collapsible|tooltip|scroll-area|marker|separator|badge|button|input|textarea|switch|progress|skeleton|label|kbd)(?:-[a-z-]+)?)\"",
  "message": "A data-slot names a @groam/ui primitive. Render the primitive instead of copying its slot onto a hand-built element, or choose a feature-specific slot name.",
  "files": ["**/apps/web/src/features/**/*.tsx", "**/packages/ai/src/ui/**/*.tsx"],
  "excludeFiles": ["**/*.test.tsx"],
  "examples": [
    {
      "file": "apps/web/src/features/x/view.tsx",
      "source": "export const v = <span className=\"block\" data-slot=\"stacked-avatar\">x</span>;",
      "reports": true
    },
    {
      "file": "packages/ai/src/ui/x/view.tsx",
      "source": "export const v = <div data-slot=\"form-field\">x</div>;",
      "reports": true
    },
    {
      "file": "apps/web/src/features/x/view.tsx",
      "source": "export const v = <div data-slot=\"card-content\">x</div>;",
      "reports": true
    },
    {
      "file": "apps/web/src/features/x/view.tsx",
      "source": "export const v = <div data-slot=\"queue-ledger\">x</div>;",
      "reports": false
    },
    {
      "file": "apps/web/src/features/x/view.tsx",
      "source": "export const v = <div data-slot=\"planner-day\">x</div>;",
      "reports": false
    },
    {
      "file": "apps/web/src/features/x/view.tsx",
      "source": "export const v = <div data-slot=\"trip-inline-notice\">x</div>;",
      "reports": false
    },
    {
      "file": "apps/web/src/features/x/view.tsx",
      "source": "export const v = <div data-slot=\"cardinal\">x</div>;",
      "reports": false
    }
  ]
}
