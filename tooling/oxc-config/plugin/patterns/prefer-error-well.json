{
  "$schema": "../pattern.schema.json",
  "match": "node-text",
  "nodes": ["JSXOpeningElement"],
  "pattern": "<[a-z][a-z0-9]*\\s(?=.*(?<![\\w:\\[/-])rounded-xl(?![\\w./\\[-]))(?=.*(?<![\\w:\\[/-])border-destructive/20(?![\\w./\\[-]))(?=.*(?<![\\w:\\[/-])bg-destructive/5(?![\\w./\\[-])).*",
  "message": "A destructive-tinted message surface is ErrorWell (@groam/ui/components/error-well); size=\"inline\" is the compact row.",
  "files": ["**/apps/web/src/features/**/*.tsx", "**/packages/ai/src/ui/**/*.tsx"],
  "excludeFiles": ["**/*.test.tsx"],
  "examples": [
    {
      "file": "packages/ai/src/ui/x/view.tsx",
      "source": "export const v = <div className=\"rounded-xl border border-destructive/20 bg-destructive/5 px-3 py-2\">x</div>;",
      "reports": true
    },
    {
      "file": "packages/ai/src/ui/x/view.tsx",
      "source": "export const v = <div className=\"rounded-xl border border-destructive/20 bg-card p-2\">x</div>;",
      "reports": false
    },
    {
      "file": "packages/ai/src/ui/x/view.tsx",
      "source": "export const v = <div className=\"rounded-md bg-destructive/5 px-3\">x</div>;",
      "reports": false
    }
  ]
}
