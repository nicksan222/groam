{
  "$schema": "../pattern.schema.json",
  "match": "node-text",
  "nodes": ["CallExpression"],
  "pattern": "window\\.(?:alert|confirm|prompt)\\s*\\(.*",
  "message": "Use the app dialog abstraction instead of window.alert, window.confirm, or window.prompt. Native dialogs block the browser and bypass Groam UI behavior.",
  "files": ["**/apps/web/src/**"],
  "excludeFiles": [
    "**/apps/web/src/features/workspace/workspace-shell/use-confirm-dialog.tsx",
    "**/apps/web/src/**/*.test.ts",
    "**/apps/web/src/**/*.test.tsx"
  ],
  "examples": [
    {
      "file": "apps/web/src/features/example/run.ts",
      "source": "export function run() { return window.alert(\"Saved\"); }",
      "reports": true
    },
    {
      "file": "apps/web/src/features/example/run.ts",
      "source": "export function run() { return window.confirm(\"Continue?\"); }",
      "reports": true
    },
    {
      "file": "apps/web/src/features/example/run.ts",
      "source": "export function run() { return window.prompt(\"Name\"); }",
      "reports": true
    },
    {
      "file": "apps/web/src/features/example/run.ts",
      "source": "export function run(confirm) { return confirm(\"Continue?\", \"Review changes\"); }",
      "reports": false
    },
    {
      "file": "apps/web/src/features/workspace/workspace-shell/use-confirm-dialog.tsx",
      "source": "export function fallback() { return window.confirm(\"Continue?\"); }",
      "reports": false
    }
  ]
}
