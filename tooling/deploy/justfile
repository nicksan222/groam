# Releases production: Convex backend, then prebuilt landing and web sites on Vercel.
# From the repo root: `just deploy setup`, `just deploy preflight production`. CI runs `release`.

set shell := ["bash", "-euo", "pipefail", "-c"]

root := clean(source_directory() / "../..")
settings := source_directory() / "environments.json"
self := quote(just_executable()) + " --justfile " + quote(source_file())

# Show what production still needs and how to get it.
setup:
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{ root }}"
    for environment in production; do
      github_environment=prod
      switch=CONVEX_PRODUCTION_ENABLED
      echo "$environment (GitHub environment \"$github_environment\")"
      if problems="$({{ self }} _target "$environment" 2>&1 >/dev/null)"; then
        echo "  ✓ settings in tooling/deploy/environments.json"
      else
        echo "  ✗ settings in tooling/deploy/environments.json"
        grep -v '^error: recipe' <<<"$problems" | sed 's/^/      /'
      fi
      if secrets="$(gh secret list --env "$github_environment" --json name --jq '.[].name' 2>/dev/null)"; then
        missing="$({{ self }} _missing github $secrets)"
        if [[ -z $missing ]]; then echo "  ✓ GitHub environment secrets"; else echo "  ✗ GitHub environment secrets: $missing"; fi
      else
        echo "  · GitHub environment secrets not checked: run \`gh auth login\` to include them"
      fi
      if [[ "$(gh variable get "$switch" 2>/dev/null)" == true ]]; then
        echo "  ✓ $switch: releases are on"
      else
        echo "  ✗ $switch: releases are off"
      fi
      echo "  · Convex variables: checked by \`just deploy preflight $environment\`"
    done
    echo
    echo "How to set each value: docs/deployment.md#one-time-setup-per-environment"

# Check that an environment has everything it needs, reporting every gap at once.
preflight environment:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ root }}"
    target="$({{ self }} _target {{ quote(environment) }})"
    eval "$target"
    convex() { env -u CONVEX_DEPLOYMENT CONVEX_AGENT_MODE=anonymous node_modules/.bin/convex "$@"; }
    problems=()

    missing="$({{ self }} _missing github $(env | sed -n 's/^\([A-Z_]*\)=..*/\1/p'))"
    [[ -z $missing ]] || problems+=("The GitHub environment is missing $missing.")

    # Without the right key, the Convex CLI would answer for another deployment.
    if [[ ${CONVEX_DEPLOY_KEY:-} =~ ^prod:([a-z0-9-]+)\| && ${BASH_REMATCH[1]} == "$deployment_name" ]]; then
      convex_names="$(convex env list --prod --names-only)"
      missing="$({{ self }} _missing convex $convex_names)"
      [[ -z $missing ]] || problems+=("The Convex deployment is missing $missing.")
      # Email is optional like Stripe: without it sign-up skips verification and password reset is off.
      if ! grep -qx RESEND_API_KEY <<<"$(tr -s '[:space:]' '\n' <<<"$convex_names")"; then
        warning="RESEND_API_KEY is not set on the Convex deployment: sign-up skips email verification and password reset is unavailable."
        if [[ ${GITHUB_ACTIONS:-} == true ]]; then echo "::warning::$warning"; else echo "warning: $warning" >&2; fi
      fi
    else
      problems+=("CONVEX_DEPLOY_KEY is not a production key for $convex_url.")
    fi

    # Verify the token can access the frontend project before changing the backend.
    if [[ -n ${VERCEL_TOKEN:-} ]]; then
      if ! curl -fsS --max-time 20 -o /dev/null \
        -H "Authorization: Bearer $VERCEL_TOKEN" \
        "https://api.vercel.com/v9/projects/$vercel_project_id?teamId=$vercel_org_id"; then
        problems+=("VERCEL_TOKEN cannot access project $vercel_project_id in $vercel_org_id.")
      fi
    fi

    if (( ${#problems[@]} )); then
      echo "{{ environment }} is not ready to release:" >&2
      printf '  - %s\n' "${problems[@]}" >&2
      echo "Run \`just deploy setup\` for how to fix each." >&2
      exit 1
    fi
    echo "{{ environment }} has everything it needs to release."

# Publish Convex, then Vercel landing and web. A later failure leaves earlier publications live.
release environment: _trusted-publisher (preflight environment)
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ root }}"
    target="$({{ self }} _target {{ quote(environment) }})"
    eval "$target"
    convex() { env -u CONVEX_DEPLOYMENT CONVEX_AGENT_MODE=anonymous node_modules/.bin/convex "$@"; }
    assert_clean() {
      local changes
      changes="$(git status --porcelain)"
      [[ -z $changes ]] || { printf 'The deploy checkout has uncommitted changes:\n%s\n' "$changes" >&2; exit 1; }
    }
    [[ "$(git rev-parse HEAD)" == "$GITHUB_SHA" ]] || { echo "Deploy checkout does not match the tested commit." >&2; exit 1; }
    assert_clean

    # SITE_URL follows the Vercel web origin and AUTH_EMAIL_FROM the environment's emailFrom;
    # BETTER_AUTH_SECRET is generated once, never replaced or printed.
    names="$(convex env list --prod --names-only | tr -s '[:space:]' '\n')"
    if ! grep -qx SITE_URL <<<"$names" || [[ "$(convex env get SITE_URL --prod)" != "$site_url" ]]; then
      printf %s "$site_url" | convex env set SITE_URL --prod
    fi
    if ! grep -qx BETTER_AUTH_SECRET <<<"$names"; then
      openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n' | convex env set BETTER_AUTH_SECRET --prod
    fi
    if ! grep -qx AUTH_EMAIL_FROM <<<"$names" || [[ "$(convex env get AUTH_EMAIL_FROM --prod)" != "$email_from" ]]; then
      printf %s "$email_from" | convex env set AUTH_EMAIL_FROM --prod
    fi
    convex deploy --typecheck-components --codegen disable --message "GitHub {{ environment }} main $GITHUB_SHA"

    # Builds receive only public destinations. Upload only the prebuilt output afterwards.
    build() {
      (
        cd "apps/$1"
        base=/
        [[ $1 == web ]] && base=/app/
        export PATH="$PWD/node_modules/.bin:{{ root }}/node_modules/.bin:$PATH"
        env -u CONVEX_DEPLOY_KEY -u CONVEX_DEPLOYMENT -u VERCEL_TOKEN \
          VITE_CONVEX_URL="$convex_url" \
          VITE_CONVEX_SITE_URL="$backend_site_url" \
          VITE_SITE_URL="$site_url" \
          VITE_LANDING_URL="$landing_url" \
          LANDING_SITE_URL="$landing_url/" \
          STATIC_HOSTING_BASE_PATH="$base" \
          ASTRO_TELEMETRY_DISABLED=1 \
          bun run build
      )
    }
    staging="$(mktemp -d)"
    trap 'rm -rf "$staging"' EXIT
    upload() {
      bun tooling/deploy/prepare-vercel.ts apps/landing/dist apps/web/dist "$staging" \
        "$vercel_project_id" "$vercel_org_id"
      printf %s "$VERCEL_TOKEN" | env -u CONVEX_DEPLOY_KEY -u CONVEX_DEPLOYMENT -u VERCEL_TOKEN \
        bun tooling/deploy/publish-vercel.ts "$staging"
    }
    smoke() {
      curl -fsS --retry 3 --retry-delay 5 --retry-all-errors --max-time 30 -o /dev/null "$1" ||
        { echo "Smoke check failed: $1 did not respond after deploying $2." >&2; exit 1; }
    }
    # The web app's HTML names its hashed bundles; fetching one proves the assets, not just the shell, are served.
    smoke_web_assets() {
      local html asset
      html="$(curl -fsS --retry 3 --retry-delay 5 --retry-all-errors --max-time 30 "$site_url/")" ||
        { echo "Smoke check failed: $site_url/ did not respond after deploying web." >&2; exit 1; }
      asset="$(grep -oE '/app/assets/[^"'"'"' <>]+\.js' <<<"$html" | head -n 1 || true)"
      [[ -n $asset ]] || { echo "Smoke check failed: $site_url/ references no /app/assets/*.js bundle." >&2; exit 1; }
      smoke "https://$host$asset" "web (asset $asset)"
    }
    build landing
    build web
    upload
    smoke "$landing_url/" landing
    smoke "$site_url/" web
    smoke "$site_url/settings/ai" "web deep link"
    smoke "$landing_url/it/" "localized landing"
    smoke_web_assets

    assert_clean

# Only the trusted main-branch workflow may publish, on a main push or a manual release.
[private]
_trusted-publisher:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "${GITHUB_ACTIONS:-}" != true || "${GITHUB_REPOSITORY:-}" != nicksan222/groam ||
          "${GITHUB_REF:-}" != refs/heads/main || ! "${GITHUB_EVENT_NAME:-}" =~ ^(push|workflow_dispatch)$ ||
          ! "${GITHUB_SHA:-}" =~ ^[a-f0-9]{40}$ ]]; then
      echo "Release publishing is restricted to the trusted main-branch GitHub Actions workflow." >&2
      exit 1
    fi

# Validated destinations for one environment, printed as shell assignments for `eval`.
[private]
_target environment:
    #!/usr/bin/env bash
    set -euo pipefail
    case {{ quote(environment) }} in production) ;; *)
      echo "Unknown environment \"{{ environment }}\"; use production." >&2; exit 1 ;;
    esac
    setting() { jq -r --arg environment {{ quote(environment) }} ".[\$environment].$1 // \"\"" "{{ settings }}"; }
    problems=()
    label='[a-z0-9]([a-z0-9-]*[a-z0-9])?'

    convex_url="$(setting convexUrl)"
    if [[ $convex_url =~ ^https://(([a-z0-9]+(-[a-z0-9]+)*)(\.[a-z]{2}-[a-z]+-[0-9]+)?)\.convex\.cloud$ ]]; then
      deployment_name="${BASH_REMATCH[2]}"
      backend_site_url="https://${BASH_REMATCH[1]}.convex.site"
    else
      problems+=("convexUrl must be the Convex production deployment URL (https://<name>.convex.cloud).")
    fi

    host="$(setting host)"
    if [[ ! $host =~ ^$label(\.$label)+$ || $host =~ \.convex\.(site|cloud)$ ]]; then
      problems+=("host must be a production hostname assigned to the Vercel project (without a scheme or path).")
    fi
    for key in vercelOrgId vercelProjectId; do
      value="$(setting "$key")"
      [[ $value =~ ^[A-Za-z0-9_]+$ ]] || problems+=("$key must be the Vercel ID from project settings.")
      case "$key" in
        vercelOrgId) vercel_org_id="$value" ;;
        vercelProjectId) vercel_project_id="$value" ;;
      esac
    done

    # Resend sends from this address, so it must be a real one on a verified domain.
    email_from="$(setting emailFrom)"
    angled='<([^<>[:space:]]+)>$'
    [[ $email_from =~ $angled ]] && email="${BASH_REMATCH[1]}" || email="$email_from"
    if [[ ! $email =~ ^[^@[:space:]]+@[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+)+$ || $email =~ \.(localhost|example)$ ]]; then
      problems+=("emailFrom must be the sender address, e.g. \"Groam <noreply@groam.app>\".")
    fi

    if (( ${#problems[@]} )); then
      printf '%s\n' "${problems[@]}" >&2
      exit 1
    fi
    for name in convex_url deployment_name backend_site_url host vercel_org_id vercel_project_id email_from; do
      printf '%s=%q\n' "$name" "${!name}"
    done
    printf 'site_url=%q\nlanding_url=%q\n' "https://$host/app" "https://$host"

# The variables of one store (github, convex) still missing, given the names present.
[private]
_missing store *present:
    @bun --no-env-file -e 'import { missingVariables } from "@groam/env/deployment"; const [store, ...present] = process.argv.slice(1); console.log(missingVariables(store, new Set(present)).join(", "))' -- {{ quote(store) }} {{ present }}
