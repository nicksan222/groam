{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groam.app/schemas/deploy-environments.json",
  "title": "Groam release environments",
  "description": "Public production destinations and Vercel project IDs. Empty values mark unfinished setup; release preflight rejects them. Secrets live in the GitHub prod environment.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "production": {
      "$ref": "#/$defs/environment"
    }
  },
  "required": ["production"],
  "additionalProperties": false,
  "$defs": {
    "environment": {
      "type": "object",
      "properties": {
        "convexUrl": {
          "description": "The Convex production deployment URL, from the project's dashboard.",
          "type": "string",
          "pattern": "^$|^https://[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z]{2}-[a-z]+-[0-9]+)?\\.convex\\.cloud$"
        },
        "emailFrom": {
          "description": "Sender of authentication mail, optionally with a display name; Resend sends from it, so its domain must be verified there.",
          "type": "string",
          "pattern": "^$|^(?!.*\\.(localhost|example)>?$)([^<>@]+ <[^<>\\s@]+@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+>|[^<>\\s@]+@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+)$"
        },
        "host": {
          "description": "Bare production hostname assigned to the Vercel project. Empty until configured.",
          "type": "string",
          "pattern": "^$|^(?!.*\\.convex\\.(site|cloud)$)[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        },
        "vercelOrgId": {
          "description": "Vercel team/account ID.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_]*$"
        },
        "vercelProjectId": {
          "description": "Vercel project ID (prj_\u2026).",
          "type": "string",
          "pattern": "^[A-Za-z0-9_]*$"
        }
      },
      "required": ["convexUrl", "emailFrom", "host", "vercelOrgId", "vercelProjectId"],
      "additionalProperties": false
    }
  }
}
