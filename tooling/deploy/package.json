{
  "name": "@groam/deploy",
  "version": "0.0.0",
  "dependencies": {
    "@groam/devkit": "workspace:*",
    "@groam/env": "workspace:*",
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "@groam/typescript-config": "workspace:*",
    "@groam/vitest-config": "workspace:*",
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "exports": {
    "./environments": "./src/environments.ts"
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "deploy:beta": "GROAM_ENVIRONMENT=beta bun --no-env-file src/release.ts",
    "deploy:production": "GROAM_ENVIRONMENT=production bun --no-env-file src/release.ts",
    "setup": "bun --no-env-file src/setup/checklist.ts",
    "test": "vp test run",
    "test:deployed": "vp test run --config e2e/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module"
}
