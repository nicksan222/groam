{
  "$schema": "../rule.schema.json",
  "harness": "forbidden-files",
  "message": "Use TypeScript instead of .mjs for repository-owned modules",
  "include": ["**/*.mjs"],
  "examples": [
    {
      "files": {
        "tooling/check.ts": ""
      },
      "reports": []
    },
    {
      "files": {
        "tooling/check.mjs": ""
      },
      "reports": ["tooling/check.mjs"]
    }
  ]
}
