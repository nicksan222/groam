{
  "$schema": "../rule.schema.json",
  "harness": "path-names",
  "message": "Source file names must use kebab-case",
  "target": "files",
  "include": ["**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}", "**/*.astro"],
  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
  "exceptions": [
    {
      "within": "apps/landing/src/pages/**",
      "pattern": "^\\[(?:\\.\\.\\.)?[a-z][a-z0-9-]*\\]$"
    }
  ],
  "examples": [
    {
      "files": {
        "apps/web/src/features/trips/trip-view.test.tsx": "",
        "apps/landing/src/pages/it/[...page].astro": "",
        "apps/landing/src/pages/[slug].astro": ""
      },
      "reports": []
    },
    {
      "files": {
        "apps/web/src/features/trips/TripView.tsx": "",
        "apps/web/pages/TripPage.tsx": "",
        "apps/landing/src/pages/BadName.astro": ""
      },
      "reports": [
        "apps/web/src/features/trips/TripView.tsx",
        "apps/web/pages/TripPage.tsx",
        "apps/landing/src/pages/BadName.astro"
      ]
    }
  ]
}
